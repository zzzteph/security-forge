# Secrets & per-copy config values
.env

# Cloned target repository (re-created on each run)
/target/

# Pipeline state & scratch
/state/
/logs/
/findings/
/reports/

# Per-target models/findings/advisories/PoCs (regenerated each run; the durable
# cross-repo store is the committed DB below, not this folder)
/knowledge/

# The SQLite DB is a LOCAL scan store — it holds real target org/repo names and
# findings, so it is NOT committed (keeps internal data out of the repo/history).
/db/

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
