# Secrets & per-copy config values
.env

# Cloned target repository (re-created on each run)
/target/

# Pipeline state & scratch
/state/
/logs/
/reports/

# Per-target models/findings/advisories/PoCs (regenerated each run; the durable
# cross-repo store is the committed DB below, not this folder)
/knowledge/

# The SQLite DB (db/security-forge.db) IS committed on purpose — it's the org-wide
# "knowledge of all repos" store. Ignore only its transient journal sidecars.
/db/*.db-wal
/db/*.db-shm
/db/*.db-journal

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
