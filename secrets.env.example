# Copy this file to  secrets.env  (kept out of git) and fill in real values.
# These are injected into every scan by the UI runner.

# Gateway / provider key used by the litellm backend
OPENAI_API_KEY=sk-...

# Personal access token (repo-read scope) for cloning private GitHub Enterprise repos,
# e.g. github.je-labs.com. Only needed for private targets.
GHE_TOKEN=ghp_...
